[Unit]
Description=PC Open Wake-on-LAN web app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/pc-open
Environment=NODE_ENV=production
Environment=PORT=3847
EnvironmentFile=-/opt/pc-open/wake.env
ExecStart=/usr/bin/node /opt/pc-open/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
